PUID=1000
PGID=1000
TZ=America/Los_Angeles
APPDATA=/opt/docker
CONNET=dbr0
#
WGSERVERURL=remote.domain.com #optional
WGSERVERPORT=51820 #optional
WGPEERS=user0,user1,user2,user3,user4,user5,user6 #optional
WGPEERDNS=auto #optional
WGINTERNAL_SUBNET=10.254.253.0 #optional
WGALLOWEDIPS=0.0.0.0/0 #optional, 0.0.0.0/0 for everything, list only specific CIDRs 192.168.1.0/24,192.168.2.0/24
#WGALLOWEDIPS=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8 # all private networks
#WGALLOWEDIPS=192.168.1.0/24,192.168.2.0/24 #optional
WGPERSISTENTKEEPALIVE_PEERS=all #optional
WGLOG_CONFS=true #optional